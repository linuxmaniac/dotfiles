KeepAlive yes
ServerAliveInterval 30
ForwardAgent no

Host *.debian.org
   User vseva
   VerifyHostKeyDNS yes
   UserKnownHostsFile ~/.ssh/debian_known_hosts
Host *.debian.org !*.ssh.debian.org !ssh.debian.org
    ProxyJump ssh.debian.org
#    # (or {na,eu}.ssh.debian.org)

# kamailio
Host kamailio.org
 User vseva

Host jenkins.kamailio.org jenkins.dev.kamailio.org
 ProxyJump vseva@bastion.sipwork.pro
 User admin

Host deb-archive.kamailio.org codeql.kamailio.dev
 User root

Host jenkins.kamailio.org jenkins.dev.kamailio.org
 User admin

## home
Host *.torreviejawireless.org *.office *.lab !git.torreviejawireless.org !bastion.lab !bastion.torreviejawireless.org
 ForwardAgent yes
 RemoteForward /run/user/1000/gnupg/S.gpg-agent /run/user/1000/gnupg/S.gpg-agent.extra
 RemoteForward /run/user/1000/gnupg/S.gpg-agent.ssh /run/user/1000/gnupg/S.gpg-agent.ssh

Host bastion.lab bastion.torreviejawireless.org
 ForwardAgent yes
 RemoteForward /config/.gnupg/S.gpg-agent /run/user/1000/gnupg/S.gpg-agent.extra
 RemoteForward /config/.gnupg/S.gpg-agent.ssh /run/user/1000/gnupg/S.gpg-agent.ssh

Host git.torreviejawireless.org
 AddressFamily inet
 Port 2223

Host pve*.sipwork.pro
 User root

Host opn.sipwork.pro docker*.sipwork.pro
 User root

# Geniox
Host gitlab.geniox.com
 ProxyJump bastion.sipwork.pro

Host *.staging.geniox.com
 ProxyJump bastion.sipwork.pro
 User victor

Host *.office.geniox.com !pve0*.office.geniox.com !opn.office.geniox.com
   ProxyJump root@opn.office.geniox.com

Host semaphore.office.geniox.com
   HostName 10.3.1.200

Host docker0.office.geniox.com
   User root
   HostName 10.1.1.6

Host docker1.office.geniox.com
   User root
   HostName 10.1.1.7

Host core01.office.geniox.com
   HostName 10.1.1.20

Host hss01.office.geniox.com
   HostName 10.1.1.21

Host osmo.office.geniox.com
   HostName 10.1.1.22

Host test.office.geniox.com
   HostName 10.1.1.23

Host pve01.office.geniox.com
   User root
   HostName 31.160.102.202
   ForwardAgent yes

Host pve02.office.geniox.com
   User root
   HostName 31.160.102.203
   ForwardAgent yes

Host opn.office.geniox.com
   User root
   HostName 31.160.102.204
   ForwardAgent yes
